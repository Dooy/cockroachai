m4aThread=1 #m4a 最大并发 worker 数，默认值为 1，可根据服务器性能调整 
MP3_BITRATE=192 #MP3 音频码率，可选值 128/192/256/320，默认 192
STORAGE_STRATEGY=m4a #存储策略，节省存储成本：m4a=只存m4a（默认），mp3=只存mp3，both=两者都存
M4A_MQ=mp3 #默认是空的
M4A_MP3_STREAM="1" #从stream 下载 \ 默认不去下载

WAV_SAMPLE_RATE=44100 #WAV 音频采样率（Hz），可选值 44100（CD质量）/48000（专业级，默认）/96000（高保真）
WAV_BIT_DEPTH=24 #WAV 音频位深度（bit），可选值 16（标准）/24（高质量，默认）
